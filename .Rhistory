import warnings
import pandas as pd
import plotly.express as px
from cdi_viz.theme import (
cdi_notebook_init,
set_cdi_theme,
show_and_save_plotly,
)
warnings.filterwarnings("ignore")
# Chapter init: sets Plotly theme + resets the shared figure counter
cdi_notebook_init(chapter="06", title_x=0)
df = pd.read_csv("data/cdi-student-outcomes.csv")
df.head()
list(df.columns)
fig = px.scatter(
df,
x="study_hours",
y="math_score",
color="test_prep",
hover_data=["group", "reading_score", "writing_score"],
title="Study Hours vs Math Score (Interactive)",
)
set_cdi_theme(fig, title_x=0)
# Development mode: interactive view + exported PNG
show_and_save_plotly(fig, show=True)  # figures/06_001.png
fig = px.histogram(
df,
x="math_score",
color="test_prep",
barmode="overlay",
opacity=0.65,
nbins=30,
title="Distribution of Math Scores",
)
set_cdi_theme(fig, title_x=0)
# Book rendering: save PNG only (no interactive output)
show_and_save_plotly(fig, show=False)  # figures/06_002.png
fig = px.box(
df,
x="test_prep",
y="math_score",
points="all",
title="Math Score by Test Preparation",
)
fig.update_layout(
xaxis_title="Test preparation",
yaxis_title="Math score",
)
set_cdi_theme(fig, title_x=0)
show_and_save_plotly(fig, show=False)  # figures/06_003.png
fig = px.scatter(
df,
x="study_hours",
y="math_score",
color="test_prep",
facet_col="group",
title="Study Hours vs Math Score (Faceted by Group)",
)
set_cdi_theme(fig, title_x=0)
show_and_save_plotly(fig, show=False)  # figures/06_004.png
